# Loaded by `vite --mode online` / `vite build --mode online` (see vite.web.config.ts).
# Turns the renderer into the online edition: read-only, capped rows, exports
# replaced by download prompts, share links and the sample gallery enabled.
VITE_CYCLEVIEW_ONLINE=1
VITE_ONLINE_ROW_LIMIT=50
VITE_DESKTOP_DOWNLOAD_URL=https://www.dynmech.com/download/
