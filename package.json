{
  "name": "dynmech-cycleview",
  "version": "1.0.0",
  "description": "DYNMECH CycleView - a free cross-platform desktop tool for visualising and analysing equipment motion timing (cycle time)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.web.config.ts --mode online",
    "start": "vite build && electron .",
    "build": "tsc && vite build && electron-builder",
    "build:web": "tsc && vite build --config vite.web.config.ts --mode online",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "vite",
    "dist": "npm run build",
    "dist:mac": "npm run build -- --mac",
    "dist:win": "npm run build -- --win",
    "dist:linux": "npm run build -- --linux"
  },
  "keywords": [
    "dynmech",
    "cycleview",
    "cycle-time",
    "timing-chart",
    "gantt",
    "automation",
    "mechanism"
  ],
  "author": "DYNMECH",
  "license": "Apache-2.0",
  "homepage": "https://dynmech.com",
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/papaparse": "^5.3.16",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vite-plugin-electron": "^0.15.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.7",
    "@ffmpeg/util": "^0.12.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@types/uuid": "^10.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "electron-store": "^8.1.0",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-electron-fs-backend": "^3.0.3",
    "immer": "^10.0.3",
    "lodash": "^4.17.21",
    "lucide-react": "^0.298.0",
    "lz-string": "^1.5.0",
    "mp4-muxer": "^5.2.2",
    "papaparse": "^5.4.1",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-hotkeys-hook": "^4.4.1",
    "react-i18next": "^15.6.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "zustand": "^4.4.7"
  },
  "build": {
    "appId": "com.dynmech.cycleview",
    "productName": "DYNMECH CycleView",
    "copyright": "Copyright © 2026 DYNMECH",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "DYNMECH-CycleView-Setup-${version}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ],
      "artifactName": "DYNMECH-CycleView-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "DYNMECH-CycleView-Portable-${version}.${ext}"
    }
  }
}
